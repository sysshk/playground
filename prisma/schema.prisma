// PT 매니저 — Prisma schema
// 트레이너(User) 계정별로 회원/운동기록/체중/코칭메모/영양 데이터를 분리해 보관함

generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  // 중첩 include를 관계마다 따로 보내지 않고 JOIN 한 번으로 읽음
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (next-auth)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  /// 연락처. 회원 계정은 연결된 회원 기록의 연락처와 같이 바뀜
  phone         String?
  /// 가입하면 회원(client)으로 시작하고, 관리자가 트레이너·관리자로 올림
  role          String    @default("client") // admin | trainer | client(회원 본인)
  accounts      Account[]
  sessions      Session[]
  members       Member[]  @relation("TrainerMembers")
  /// role이 client일 때 이 계정이 보는 회원 기록
  memberRecord  Member?   @relation("MemberAccount")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// PT 도메인
// ─────────────────────────────────────────────

/// 회원 (트레이너가 관리하는 PT 회원)
model Member {
  id                String    @id @default(cuid())
  trainerId         String
  trainer           User      @relation("TrainerMembers", fields: [trainerId], references: [id], onDelete: Cascade)
  /// 회원 본인 로그인 계정. 초대 링크로 가입하면 채워짐
  userId            String?   @unique
  user              User?     @relation("MemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  /// 아직 안 쓴 초대 링크. 쓰거나 취소하면 비움
  inviteToken       String?   @unique
  inviteExpiresAt   DateTime?
  name              String
  phone             String
  goal              String? // 체중 감량, 근력 향상 등
  targetWeight      Float? // 목표 체중 kg — 체중 그래프에서 고침
  remainingSessions Int       @default(0) // 남은 PT 세션
  memo              String? // 특이사항 (컨디션, 일정, 주의사항 등)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workouts     Workout[]
  weights      WeightRecord[]
  notes        CoachingNote[]
  completions  SessionCompletion[]
  appointments Appointment[]
  nutrition    NutritionProfile?
  questions    Question[]
  meals        Meal[]

  @@index([trainerId, createdAt])
}

/// 하루치 운동 기록 (종목 여러 개를 묶음)
model Workout {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  memo      String? // 폼 체크, 컨디션 등
  /// 회원이 혼자 한 개인 운동. 수업이 아니라 남은 수업을 차감하지 않음
  byMember  Boolean  @default(false)
  createdAt DateTime @default(now())

  exercises  Exercise[]
  completion SessionCompletion?

  @@index([memberId, date])
}

/// 운동 종목. 세트별 수치는 ExerciseSet이 따로 가짐
/// 드롭세트·피라미드처럼 세트마다 횟수와 무게가 달라지는 경우가 흔함
model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String // 종목명 (벤치프레스, 스쿼트 등)
  order     Int     @default(0)
  /// 세트 사이 휴식 초. 정하지 않았으면 null
  restSeconds Int?

  sets ExerciseSet[]

  @@index([workoutId, order])
}

/// 한 세트 (횟수 + 무게)
model ExerciseSet {
  id          String   @id @default(cuid())
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order       Int // 1세트, 2세트 …
  reps        Int
  weight      Float? // 바디웨이트면 null, 좌우면 왼쪽 무게
  weightRight Float? // 좌우일 때만 오른쪽 무게
  unit        String   @default("kg") // kg | bodyweight | sides

  @@index([exerciseId, order])
}

/// 체중 기록. 인바디 칸을 채우면 인바디 측정 1회로 봄
model WeightRecord {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  weight    Float
  memo      String? // 공복 측정, 운동 후 측정 등
  createdAt DateTime @default(now())

  // 인바디 — 전부 선택
  measuredHour      Int? // 측정 시각 0~23
  gender            String? // male | female
  age               Int?
  height            Float? // cm
  skeletalMuscle    Float? // 골격근량 kg
  bodyFatMass       Float? // 체지방량 kg
  bodyFatPercent    Float? // 체지방률 %
  waistHipRatio     Float? // 복부지방률 (0.85 등)
  visceralFatLevel  Int? // 내장지방 레벨 1~20
  visceralFatArea  Float? // 내장지방 면적 cm²
  balanceUpper      String? // 신체균형 상체 — balanced | slight | severe
  balanceLower      String? // 신체균형 하체
  balanceUpperLower String? // 신체균형 상하체
  leanRightArm      Float? // 부위별 근육 오른팔 kg
  leanRightArmPct   Float? // 오른팔 표준 대비 %
  leanLeftArm       Float? // 부위별 근육 왼팔 kg
  leanLeftArmPct    Float? // 왼팔 표준 대비 %
  leanTrunk         Float? // 부위별 근육 몸통 kg
  leanTrunkPct      Float? // 몸통 표준 대비 %
  leanRightLeg      Float? // 부위별 근육 오른다리 kg
  leanRightLegPct   Float? // 오른다리 표준 대비 %
  leanLeftLeg       Float? // 부위별 근육 왼다리 kg
  leanLeftLegPct    Float? // 왼다리 표준 대비 %

  @@index([memberId, date])
}

/// 코칭 메모 (통증 / 자세 / 움직임 / 숙제)
model CoachingNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  pain      String? // 통증 부위, 강도, 발생 상황
  posture   String? // 골반, 어깨, 척추 정렬 등
  movement  String? // 스쿼트, 힙힌지, 보행 등 움직임 관찰
  homework  String? // 다음 수업 전 수행할 운동이나 습관
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, date])
}

/// 수업 완료 내역 (완료 시 남은 수업 1회 차감)
/// 운동 기록을 저장하면서 차감하면 그 기록과 연결됨
/// 기록을 지워도 차감 이력은 남음 — 되돌리려면 이력에서 따로 취소함
model SessionCompletion {
  id          String       @id @default(cuid())
  memberId    String
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workoutId   String?      @unique
  workout     Workout?     @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  completedAt DateTime     @default(now())
  /// 운동 기록 없이 직접 차감할 때 남기는 사유 (상담, 체형 평가 등)
  reason      String?
  /// 예약해 둔 수업을 기록했으면 그 예약
  appointment Appointment?

  @@index([memberId, completedAt])
}

/// 칼로리 및 영양 계산 결과 (회원당 1건, 다시 계산하면 덮어씀)
model NutritionProfile {
  id       String @id @default(cuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // 입력값
  gender             String // male | female
  age                Int
  height             Float // cm
  weight             Float // kg
  bodyFatPercentage  Float?
  skeletalMuscleMass Float? // 골격근량 kg
  leanBodyMass       Float? // 직접 입력한 제지방량 kg
  activityLevel      String // sedentary | light | moderate | veryActive | extraActive
  goal               String // loss | maintain | gain

  // 계산 결과
  calculatedLeanBodyMass Float?
  leanBodyMassSource     String // direct | bodyFat | unavailable
  bmr                    Int
  maintenanceCalories    Int
  targetCalories         Int
  protein                Int
  proteinMin             Int
  proteinMax             Int
  carbs                  Int
  fat                    Int
  calculationBasis       String[] // 계산 기준 설명 줄들

  updatedAt DateTime @updatedAt
}

/// 회원이 적는 식단 한 끼. 트레이너가 한 줄 코멘트를 달 수 있음
model Meal {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  slot        String // breakfast | lunch | dinner | snack
  content     String
  calories    Int? // kcal — AI 추정
  carbs       Float? // g
  fat         Float? // g
  protein     Float? // g
  comment     String? // 트레이너 코멘트
  commentedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([memberId, date])
}

/// 회원이 묻고 트레이너가 답하는 Q&A. 질문 하나에 답 하나
model Question {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([memberId, createdAt])
}

/// 앞으로 할 수업 예약. 남은 수업은 차감하지 않음
/// 기록하면 그때 만든 완료 내역과 이어지고, 달력에서는 완료 내역으로 보임
model Appointment {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// 시작 시각. 30분 단위로 받음
  startsAt DateTime
  memo     String?

  completionId String?            @unique
  completion   SessionCompletion? @relation(fields: [completionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memberId, startsAt])
  @@index([startsAt])
}
