// PT 매니저 — Prisma schema
// 트레이너(User) 계정별로 회원/운동기록/체중/코칭메모/영양 데이터를 분리해 보관한다.

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 인증 (next-auth)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          String    @default("trainer") // trainer | admin
  accounts      Account[]
  sessions      Session[]
  members       Member[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// PT 도메인
// ─────────────────────────────────────────────

/// 회원 (트레이너가 관리하는 PT 회원)
model Member {
  id                String   @id @default(cuid())
  trainerId         String
  trainer           User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  goal              String? // 체중 감량, 근력 향상 등
  remainingSessions Int      @default(0) // 남은 PT 세션
  memo              String? // 특이사항 (컨디션, 일정, 주의사항 등)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workouts    Workout[]
  weights     WeightRecord[]
  notes       CoachingNote[]
  completions SessionCompletion[]
  nutrition   NutritionProfile?

  @@index([trainerId, createdAt])
}

/// 하루치 운동 기록 (종목 여러 개를 묶는다)
model Workout {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  memo      String? // 폼 체크, 컨디션 등
  createdAt DateTime @default(now())

  exercises  Exercise[]
  completion SessionCompletion?

  @@index([memberId, date])
}

/// 운동 종목. 세트별 수치는 ExerciseSet이 따로 갖는다.
/// 드롭세트·피라미드처럼 세트마다 횟수와 무게가 달라지는 경우가 흔하다.
model Exercise {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String // 종목명 (벤치프레스, 스쿼트 등)
  order     Int     @default(0)

  sets ExerciseSet[]

  @@index([workoutId, order])
}

/// 한 세트 (횟수 + 무게)
model ExerciseSet {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int // 1세트, 2세트 …
  reps       Int
  weight     Float? // 바디웨이트면 null
  unit       String   @default("kg") // kg | bodyweight

  @@index([exerciseId, order])
}

/// 체중 기록
model WeightRecord {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  weight    Float
  memo      String? // 공복 측정, 운동 후 측정 등
  createdAt DateTime @default(now())

  @@index([memberId, date])
}

/// 코칭 메모 (통증 / 자세 / 움직임 / 숙제)
model CoachingNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  pain      String? // 통증 부위, 강도, 발생 상황
  posture   String? // 골반, 어깨, 척추 정렬 등
  movement  String? // 스쿼트, 힙힌지, 보행 등 움직임 관찰
  homework  String? // 다음 수업 전 수행할 운동이나 습관
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, date])
}

/// 수업 완료 내역 (완료 시 남은 수업 1회 차감)
/// 운동 기록을 저장하면서 차감하면 그 기록과 연결된다.
/// 기록을 지워도 차감 이력은 남는다 — 되돌리려면 이력에서 따로 취소한다.
model SessionCompletion {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workoutId   String?  @unique
  workout     Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  completedAt DateTime @default(now())

  @@index([memberId, completedAt])
}

/// 칼로리 및 영양 계산 결과 (회원당 1건, 다시 계산하면 덮어쓴다)
model NutritionProfile {
  id       String @id @default(cuid())
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // 입력값
  gender              String // male | female
  age                 Int
  height              Float // cm
  weight              Float // kg
  bodyFatPercentage   Float?
  skeletalMuscleMass  Float? // 골격근량 kg
  leanBodyMass        Float? // 직접 입력한 제지방량 kg
  activityLevel       String // sedentary | light | moderate | veryActive | extraActive
  goal                String // loss | maintain | gain

  // 계산 결과
  calculatedLeanBodyMass Float?
  leanBodyMassSource     String // direct | bodyFat | unavailable
  bmr                    Int
  maintenanceCalories    Int
  targetCalories         Int
  protein                Int
  proteinMin             Int
  proteinMax             Int
  carbs                  Int
  fat                    Int
  calculationBasis       String[] // 계산 기준 설명 줄들

  updatedAt DateTime @updatedAt
}
