# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
#
# .env 는 .gitignore에 걸려 있어 커밋되지 않습니다. 실제 비밀값을 커밋하지 마세요.
# 배포(Vercel)에서는 파일이 아니라 대시보드의 Environment Variables를 씁니다.

# Neon Postgres 연결 문자열
# Neon 콘솔 → 프로젝트 → Connection string (Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Auth.js 세션 서명 키 — 아래 명령으로 생성
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
